<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A growing collection of focused tools for tabletop role-playing games."
    />
    <title>Zippin's Toolkit</title>
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Almendra:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="toolkit">
      <h1>Zippin's Toolkit</h1>
      <p>A growing collection of focused tools for tabletop role-playing games.</p>

      <section aria-labelledby="tools-title">
        <h2 id="tools-title">Available tools</h2>
        <a class="toolkit__tool" href="fantasy-calendar/">
          <span class="material-icons" aria-hidden="true">calendar_month</span>
          <div>
            <h3>Fantasy Calendar</h3>
            <p>
              Explore the Calendar of Harptos, festivals, leap days, and moon phases.
            </p>
          </div>
        </a>
        <a class="toolkit__tool" href="encounter-difficulty-calculator/">
          <span class="material-icons" aria-hidden="true">casino</span>
          <div>
            <h3>Encounter Difficulty Calculator</h3>
            <p>Calculate party XP thresholds and rank a custom encounter.</p>
          </div>
        </a>
      </section>
    </main>
    <footer class="site-footer">
      <a
        class="site-footer__link"
        href="https://github.com/ruslan-sh/zippin-toolkit"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="site-footer__github-icon" aria-hidden="true" viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        View on GitHub
      </a>
    </footer>
  </body>
</html>
