<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Page moved</title>
    <script>
      const target = new URL(<%= JSON.stringify(htmlWebpackPlugin.options.target) %>, window.location.href);
      target.search = window.location.search;
      target.hash = window.location.hash;
      window.location.replace(target.href);
    </script>
  </head>
  <body>
    <a href="<%= htmlWebpackPlugin.options.target %>">Open the app</a>
  </body>
</html>
